[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Yasith Vidanaarachchi
	email = yasith.vidanaarachchi@gmail.com

[alias]
  br = branch --list
  co  = checkout
  ci  = commit
  cia = commit -a --amend
  st = status
  dt = difftool
[diff]
	tool = meld
[difftool]
	prompt = false
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
  side-by-side = true
  line-numbers = true
[merge]
	conflictStyle = zdiff3
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
